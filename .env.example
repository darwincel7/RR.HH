# Configuración de Correo (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_MODEL (opcional): modelo de IA usado para analizar CV, calificar el
# formulario de etapa 2 y evaluar el test presencial. El valor por defecto es una
# versión "preview" y Google las retira sin aviso; si un día la IA deja de
# responder, cambia este valor por el modelo vigente y reinicia — sin tocar código.
GEMINI_MODEL=

# ALERT_EMAIL (opcional): a quién avisar por correo cuando algo crítico falla
# (WhatsApp desvinculado, la IA fallando todos los CV). Por defecto, el admin.
ALERT_EMAIL=

# CV_WORKER_TOKEN (opcional): secreto compartido para que un ping programado
# (Cloud Scheduler / uptime check) pueda vaciar la cola de CV sin iniciar sesión:
#   POST /api/cv-worker/run  con la cabecera  X-CV-Worker-Token: <este valor>
# Sin él, el endpoint solo lo pueden llamar reclutadores autenticados.
CV_WORKER_TOKEN=
